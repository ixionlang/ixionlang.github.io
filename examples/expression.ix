use <std>

type Expr = enum {
    Number(value: int),
    Add(left: Expr, right: Expr),
}

def eval(expr: Expr): int {
    return case expr {
        Expr::Number(n) => n,
        Expr::Add(a, b) => eval(a) + eval(b),
    }
}

def main() {
    const expr = Expr::Add(
        Expr::Number(20), Expr::Number(22)
    )
    std::println(eval(expr))
}
